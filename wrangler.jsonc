// Hosting: one Cloudflare Worker (docs/ARCHITECTURE.md, "Hosting" and "The backend"). It
// serves the built site as static files and answers /api/* itself (worker/). The build is
// `pnpm build`, the deploy `npx wrangler deploy`.
//
// This file being here is what stops Cloudflare's automatic project setup, which runs when
// a repository has no Wrangler configuration and, on 2026-11-17, failed the deploy by
// installing wrangler with pnpm (ERR_PNPM_IGNORED_BUILDS).
{
  // Must be the Worker's name in the Cloudflare dashboard.
  "name": "soccersense",
  "compatibility_date": "2026-11-17",
  // Wrangler sends Cloudflare nothing about how it is used here.
  "send_metrics": false,
  // The API. Everything it needs is bundled from here by wrangler.
  "main": "worker/index.ts",
  "assets": {
    // What `pnpm build` writes: every page as a file, and 404.html (tools/not-found.ts).
    "directory": "./build/client",
    "binding": "ASSETS",
    // Only the API goes to the Worker: every other address is served straight from the
    // files, without running (or paying for) any code.
    "run_worker_first": ["/api/*"],
    // A page is served at its address as the game links to it, "/play/home", with no
    // closing slash ("/play/home/" is sent there). The sitemap and the canonical links
    // (app/routes/seo.ts) say the same.
    "html_handling": "drop-trailing-slash",
    // An address that is not a page gets 404.html with a "404 Not Found": the app's shell,
    // which shows the Offside! page and asks not to be indexed.
    "not_found_handling": "404-page"
  },
  // The database (D1). It has no id here: Cloudflare makes it on the first deploy and keeps
  // its id in the dashboard. The Worker creates and updates its own tables
  // (worker/db/migrate.ts), so nothing is run by hand.
  "d1_databases": [{ "binding": "DB", "database_name": "soccersense" }],
  // How often one connection may ask for a sign-in link to be emailed: 5 a minute
  // (worker/accounts/api.ts). Cloudflare counts it in memory; nothing is kept.
  // `namespace_id` is any number of our own choosing that names this counter.
  "ratelimits": [
    {
      "name": "SIGN_IN_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    },
    // How many moves of the games one player may send: 120 a minute (worker/app.ts). An
    // account is counted by itself, anyone else by their connection. A whole game is about
    // 16 requests, so only a script comes near it.
    {
      "name": "GAME_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 120, "period": 60 }
    }
  ],
  // The secrets are not here and never will be: the product owner puts them in the
  // Cloudflare dashboard (the Worker's Settings, "Variables and Secrets", type Secret):
  //   ADMIN_TOKEN           the approval desk's key
  //   RESEND_API_KEY        the email service's key, for sign-in links
  //   GOOGLE_CLIENT_SECRET  the Google sign-in client's secret
  //   TURNSTILE_SECRET_KEY  the bot check's (Cloudflare Turnstile) secret key
  // For `pnpm api` on a developer's machine they go in a file called .dev.vars (one
  // NAME=value a line), which git ignores.
  "vars": {
    // Who the sign-in email is from. The domain must be verified in Resend.
    "MAIL_FROM": "soccersense <signin@soccersense.io>",
    // Where each day's questions come from: "sample" (the questions built into the game)
    // or "scheduled" (the ones approved and scheduled for the day). A feature flag: leave
    // it at "sample" while the game is in testing.
    "QUESTIONS": "sample",
    // The bot check's site key (Cloudflare Turnstile, on asking for a sign-in link). Not a
    // secret: it is in every page that shows the check. Its secret key is a secret (above).
    "TURNSTILE_SITE_KEY": "0x4AAAAAAGGDv04TBSbYhvnI",
    // The Google sign-in client's id. Not a secret either: it is in every link to Google's
    // sign-in page. Its secret is a secret (above).
    "GOOGLE_CLIENT_ID": "999264126454-vdk54s13i2u0pgpls8h10lddf9p1feld.apps.googleusercontent.com"
  }
}
